# Everything under butler/ that isn't a doc or image ends up on an Alpine VM,
# parsed by a POSIX shell, OpenRC or Python, which do not tolerate a CRLF
# shebang or config line. Pin these to LF regardless of the committer's local
# core.autocrlf (same rule as confetti-traffic), so a Windows checkout can't
# silently reintroduce CRLF into the stored blob.

*.sh    text eol=lf
*.initd text eol=lf
*.py    text eol=lf

butler/requirements.txt       text eol=lf
butler/seed/*.sample          text eol=lf

# Read by Alpine (the Packer answer file is sourced by sh), by Docker, or compared
# byte-for-byte against parser expectations: keep LF on a Windows checkout too.
packer/http/answers          text eol=lf
packer/*.hcl                 text eol=lf
container/*                  text eol=lf
butler/.dockerignore         text eol=lf
dev/samples/*.txt            text eol=lf
