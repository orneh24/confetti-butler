#!/sbin/openrc-run
# OpenRC service: auto-configure confetti-butler's static IP from guestinfo on
# first boot. Identical pattern to confetti-traffic's hub firstboot service — see
# that file for the full reasoning; only names differ here.

name="confetti-butler-firstboot"
description="Configure confetti-butler static IP from VMware guestinfo on first boot"

depend() {
    need net
    after open-vm-tools
    before confetti-butler
}

command_background="no"

CONF_DIR="/etc/confetti-butler"
STAMP="${CONF_DIR}/.setup-done"
ENV_STAMP="${CONF_DIR}/.env-done"
ENV_FILE="/opt/confetti-butler/butler.env"

_guestinfo() {
    if command -v vmware-rpctool >/dev/null 2>&1; then
        vmware-rpctool "info-get guestinfo.$1" 2>/dev/null | tr -d '\r\n'
    elif command -v vmtoolsd >/dev/null 2>&1; then
        vmtoolsd --cmd "info-get guestinfo.$1" 2>/dev/null | tr -d '\r\n'
    fi
}

# A guestinfo value, or nothing if the key is unset.
_guestinfo_value() {
    _v=$(_guestinfo "$1")
    case "$_v" in *"No value found"*) _v="" ;; esac
    printf '%s' "$_v"
}

# Set KEY=value in butler.env: drop any existing line, append the new one.
# (No sed: a password can contain any character sed would treat as special.)
_env_set() {
    _tmp="${ENV_FILE}.tmp"
    grep -v "^$1=" "$ENV_FILE" > "$_tmp" || true
    printf '%s=%s\n' "$1" "$2" >> "$_tmp"
    chmod 600 "$_tmp"
    mv -f "$_tmp" "$ENV_FILE"
}

# Poller defaults from guestinfo, applied once per clone. Independent of the
# IP setup below: a clone on DHCP can still get credentials this way.
#   guestinfo.butler.ssh_username / ssh_password / ssh_secret / poll_interval_s
# Anything stored in guestinfo is visible to whoever can view the VM's
# advanced settings in vCenter; per-device credentials can still be set later.
_apply_env() {
    [ -f "$ENV_STAMP" ] && return 0
    [ -f "$ENV_FILE" ] || return 0
    _any=""
    for _pair in ssh_username:BUTLER_SSH_USERNAME ssh_password:BUTLER_SSH_PASSWORD                  ssh_secret:BUTLER_SSH_SECRET poll_interval_s:BUTLER_POLL_DEFAULT_INTERVAL_S; do
        _val=$(_guestinfo_value "butler.${_pair%%:*}")
        if [ -n "$_val" ]; then
            _env_set "${_pair#*:}" "$_val"
            _any="yes"
        fi
    done
    if [ -n "$_any" ]; then
        mkdir -p "$CONF_DIR"
        date -u '+%Y-%m-%dT%H:%M:%SZ applied (guestinfo)' > "$ENV_STAMP"
        einfo "applied butler.* guestinfo settings to butler.env"
    fi
}

# Later boots: apply guestinfo.butler.hostname if it is set and differs from
# the current name, so a rename in vCenter takes effect at the next reboot
# (the hub does the same). Only the hostname: the network keys stay one-shot,
# since a wrong IP applied at boot would cut the VM off.
_apply_hostname() {
    _hn=$(_guestinfo_value "butler.hostname")
    [ -n "$_hn" ] || return 0
    case "$_hn" in
        *[!A-Za-z0-9-]*|-*)
            ewarn "guestinfo.butler.hostname '$_hn' is not a valid hostname; ignored"
            return 0 ;;
    esac
    [ "$_hn" = "$(hostname)" ] && return 0

    ebegin "Renaming from guestinfo: $(hostname) -> $_hn"
    printf '%s\n' "$_hn" > /etc/hostname
    hostname "$_hn"
    if grep -q "127.0.1.1" /etc/hosts 2>/dev/null; then
        sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t${_hn}/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$_hn" >> /etc/hosts
    fi
    eend 0
}

start() {
    _apply_env

    if [ -f "$STAMP" ]; then
        _apply_hostname
        return 0
    fi

    _ip=$(_guestinfo "butler.ip")
    _gw=$(_guestinfo "butler.gateway")

    # Optional, like the wizard's prompts. Empty is passed through and
    # set-static-ip skips it.
    _dns=$(_guestinfo_value "butler.dns")
    _hn=$(_guestinfo_value "butler.hostname")

    case "$_ip" in *"No value found"*) _ip="" ;; esac
    case "$_gw" in *"No value found"*) _gw="" ;; esac

    if [ -z "$_ip" ] || [ -z "$_gw" ]; then
        ewarn "guestinfo.butler.ip / guestinfo.butler.gateway not set"
        ewarn "skipping auto-setup -- log in and run: butler-setup.sh"
        return 0
    fi

    ebegin "Configuring confetti-butler static IP from guestinfo"
    mkdir -p "$CONF_DIR"
    if set-static-ip "$_ip" "$_gw" "$_dns" "$_hn" && rc-service networking restart; then
        date -u '+%Y-%m-%dT%H:%M:%SZ configured (guestinfo)' > "$STAMP"
        eend 0
    else
        eend 1 "static IP configuration failed"
    fi

    return 0
}

stop() {
    return 0
}
